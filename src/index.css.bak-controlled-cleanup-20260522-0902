@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #050506;
  color: #f7f4ef;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 20% 0%, rgba(38, 182, 194, 0.16), transparent 28rem),
    radial-gradient(circle at 85% 12%, rgba(190, 142, 72, 0.12), transparent 26rem),
    linear-gradient(180deg, #090909 0%, #050506 100%);
  color: #f7f4ef;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.page-shell {
  width: min(1180px, calc(100% - 32px));
  min-height: 100vh;
  margin: 0 auto;
  padding: 22px 0 64px;
}

.landing-page {
  width: min(780px, calc(100% - 28px));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: 12px;
  padding-bottom: 24px;
}

.loading-page {
  display: grid;
  place-items: center;
}

.brand-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 72px;
  position: relative;
  z-index: 5;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: rgba(247, 244, 239, 0.68);
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.brand-logo {
  width: 132px;
  height: auto;
  display: block;
  filter: drop-shadow(0 18px 38px rgba(0, 0, 0, 0.35));
}

.landing-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  padding: 4px 0 0;
}

.landing-logo {
  width: min(192px, 58vw);
  height: auto;
  display: block;
  background: transparent;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
  filter: none;
  mix-blend-mode: normal;
}

.landing-powered {
  margin-top: -2px;
  color: rgba(247, 244, 239, 0.62);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
}

.language-switcher {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
  flex-wrap: wrap;
}

.flag-button {
  width: 24px;
  height: 22px;
  min-height: 22px;
  display: inline-grid;
  place-items: center;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  background: rgba(255, 255, 255, 0.045);
  cursor: pointer;
  font-size: 13px;
  opacity: 0.58;
}

.flag-button.is-active {
  opacity: 1;
  border-color: rgba(54, 218, 225, 0.8);
  box-shadow: 0 0 0 1px rgba(54, 218, 225, 0.14), 0 0 24px rgba(54, 218, 225, 0.16);
}

.landing-hero {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 26px 0 18px;
}

.landing-hero .hero-copy {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-copy h1,
.page-intro h1,
.join-card h1 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(48px, 7vw, 92px);
  line-height: 0.95;
  letter-spacing: 0;
}

.landing-hero .hero-copy h1 {
  max-width: 620px;
  font-size: clamp(34px, 4vw, 42px);
  line-height: 1.06;
  font-weight: 820;
}

.tagline {
  margin: 0 0 18px;
  color: #38dbe2;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.24em;
  text-transform: uppercase;
}

.tagline:empty {
  display: none;
}

.hero-subtitle,
.page-intro p,
.info-panel p,
.muted,
.privacy-text,
.episode-line {
  color: rgba(247, 244, 239, 0.68);
  line-height: 1.7;
}

.hero-subtitle {
  max-width: 610px;
  margin: 14px auto 0;
  font-size: 15px;
}

.landing-hero .hero-subtitle {
  max-width: 560px;
  font-size: clamp(14px, 1.5vw, 16px);
  color: rgba(247, 244, 239, 0.78);
}

.hero-intro {
  max-width: 580px;
  margin: 10px auto 18px;
  color: rgba(247, 244, 239, 0.62);
  font-size: 12px;
  line-height: 1.55;
}

.cards-kicker {
  max-width: 560px;
  margin: 0 auto 10px;
  color: rgba(247, 244, 239, 0.78);
  font-size: 12px;
  line-height: 1.45;
}

.primary-cta,
.secondary-button {
  min-height: 34px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  text-decoration: none;
  cursor: pointer;
  font-weight: 850;
  letter-spacing: 0.035em;
  font-size: 12px;
}

.primary-cta {
  padding: 0 18px;
  background: #00f0ff;
  color: #050506;
  box-shadow: 0 12px 34px rgba(0, 240, 255, 0.22);
}

.primary-cta:disabled,
.secondary-button:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.secondary-button {
  padding: 0 18px;
  color: #f7f4ef;
  border: 1px solid rgba(247, 244, 239, 0.14);
  background: rgba(255, 255, 255, 0.055);
}

.full-width {
  width: 100%;
}

.section-grid,
.metrics-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.landing-sections {
  width: 100%;
  margin-top: 0;
  margin-bottom: 10px;
}

.info-panel,
.panel,
.metric-card {
  border: 1px solid rgba(247, 244, 239, 0.1);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.22);
}

.info-panel {
  padding: 14px;
  text-align: center;
}

.info-panel h2,
.panel h2,
.panel h3,
.join-card h2 {
  margin: 0 0 12px;
  letter-spacing: 0;
}

.info-panel p {
  margin: 0;
}

.info-panel h2 {
  font-size: 14px;
  margin-bottom: 7px;
}

.info-panel p {
  font-size: 11px;
  line-height: 1.45;
}

.page-intro {
  max-width: 820px;
  padding: 48px 0 32px;
}

.page-intro h1 {
  font-size: clamp(42px, 6vw, 72px);
}

.page-intro p {
  max-width: 680px;
  margin: 18px 0 0;
  font-size: 18px;
}

.checkout-page {
  width: min(840px, calc(100% - 28px));
  padding-top: 12px;
  padding-bottom: 34px;
}

.checkout-page .landing-header {
  gap: 7px;
  padding-top: 4px;
}

.checkout-page .landing-logo {
  width: min(192px, 58vw);
}

.checkout-intro {
  max-width: 640px;
  margin: 0 auto;
  padding: 24px 0 18px;
  text-align: center;
}

.checkout-intro h1 {
  max-width: 620px;
  margin: 0 auto;
  font-size: clamp(30px, 4vw, 40px);
  line-height: 1.08;
}

.checkout-intro p {
  max-width: 600px;
  margin: 12px auto 0;
  font-size: 13px;
  line-height: 1.55;
  color: rgba(247, 244, 239, 0.66);
}

.checkout-card {
  max-width: 820px;
  margin: 0 auto;
  padding: 18px;
}

.checkout-grid {
  gap: 12px;
}

.checkout-card label {
  gap: 6px;
  font-size: 11px;
}

.checkout-card input,
.checkout-card select {
  min-height: 38px;
  padding: 0 11px;
  border-radius: 8px;
  font-size: 12px;
}

.checkout-card textarea {
  min-height: 70px;
  padding: 10px 11px;
  border-radius: 8px;
  font-size: 12px;
}

.checkout-terms {
  margin-top: 14px;
  padding: 12px;
}

.checkout-terms p {
  margin-bottom: 9px;
  font-size: 11px;
  line-height: 1.45;
}

.checkout-submit {
  width: 100%;
  margin-top: 14px;
}

.dashboard-page {
  width: min(860px, calc(100% - 28px));
  padding-top: 12px;
  padding-bottom: 36px;
}

.dashboard-page .landing-header {
  gap: 7px;
  padding-top: 4px;
}

.dashboard-page .landing-logo {
  width: min(192px, 58vw);
}

.dashboard-intro {
  max-width: 640px;
  margin: 0 auto;
  padding: 24px 0 18px;
  text-align: center;
}

.dashboard-intro h1 {
  max-width: 620px;
  margin: 0 auto;
  font-size: clamp(30px, 4vw, 40px);
  line-height: 1.08;
}

.dashboard-intro p {
  max-width: 600px;
  margin: 12px auto 0;
  font-size: 13px;
  line-height: 1.55;
  color: rgba(247, 244, 239, 0.66);
}

.dashboard-page .metrics-row {
  gap: 10px;
  margin-bottom: 10px;
}

.dashboard-page .metric-card {
  padding: 12px;
}

.dashboard-page .metric-card span,
.dashboard-page .detail-list dt {
  font-size: 9px;
  letter-spacing: 0.07em;
}

.dashboard-page .metric-card strong {
  margin-top: 5px;
  font-size: 22px;
}

.dashboard-page .dashboard-grid {
  gap: 10px;
}

.dashboard-page .panel {
  padding: 14px;
}

.dashboard-page .panel h2 {
  font-size: 15px;
  margin-bottom: 10px;
}

.dashboard-page .detail-list {
  gap: 9px;
  margin-bottom: 12px;
}

.dashboard-page .detail-list dd {
  font-size: 12px;
}

.dashboard-page label {
  gap: 6px;
  font-size: 11px;
}

.dashboard-page input,
.dashboard-page select {
  min-height: 36px;
  padding: 0 10px;
  font-size: 12px;
}

.dashboard-page textarea {
  min-height: 68px;
  padding: 10px;
  font-size: 12px;
}

.dashboard-page .button-column,
.dashboard-page .side-panel,
.dashboard-page .phone-flow {
  gap: 9px;
}

.dashboard-page .file-control {
  min-height: 36px;
  font-size: 12px;
}

.dashboard-page .qr-canvas {
  width: 150px;
  height: 150px;
  padding: 7px;
}

.dashboard-page .link-field {
  margin: 10px 0 9px;
  font-size: 11px;
}

.dashboard-page .button-row {
  gap: 8px;
}

.panel-copy,
.future-note {
  margin: 0;
  color: rgba(247, 244, 239, 0.64);
  font-size: 12px;
  line-height: 1.5;
}

.future-note {
  padding: 10px;
  border-radius: 8px;
  background: rgba(54, 218, 225, 0.06);
  border: 1px solid rgba(54, 218, 225, 0.12);
}

.podcast-video-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.video-preview-card {
  border-radius: 8px;
  border: 1px solid rgba(247, 244, 239, 0.1);
  background:
    radial-gradient(circle at 50% 0%, rgba(54, 218, 225, 0.12), transparent 58%),
    rgba(0, 0, 0, 0.28);
  padding: 12px;
}

.video-window {
  min-height: 148px;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  gap: 7px;
  padding: 16px;
  background: linear-gradient(180deg, rgba(7, 8, 10, 0.98), rgba(14, 16, 20, 0.92));
}

.video-window-bar {
  position: absolute;
  inset: 0;
  height: 42%;
  background: linear-gradient(180deg, rgba(247, 244, 239, 0.08), rgba(247, 244, 239, 0));
  border-bottom: 1px solid rgba(247, 244, 239, 0.08);
}

.video-preview-logo {
  width: 78px;
  height: auto;
  position: relative;
  z-index: 1;
}

.video-window p {
  margin: 0;
  position: relative;
  z-index: 1;
  color: rgba(247, 244, 239, 0.78);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.qr-placeholder {
  width: 54px;
  height: 54px;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5px;
  padding: 7px;
  border-radius: 8px;
  background: rgba(247, 244, 239, 0.92);
  opacity: 0.82;
}

.qr-placeholder span {
  background: #050506;
  border-radius: 2px;
}

.form-grid,
.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
  gap: 18px;
  align-items: start;
}

.dashboard-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.panel {
  padding: 24px;
}

.side-panel,
.button-column,
.phone-flow {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.input-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.input-grid.compact {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: rgba(247, 244, 239, 0.82);
  font-size: 13px;
  font-weight: 700;
}

.wide,
.bonus-panel label:last-child {
  grid-column: 1 / -1;
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid rgba(247, 244, 239, 0.12);
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.22);
  color: #f7f4ef;
  outline: 0;
}

input,
select {
  min-height: 48px;
  padding: 0 13px;
}

textarea {
  min-height: 112px;
  padding: 13px;
  resize: vertical;
}

small {
  color: #ffb36b;
  font-weight: 600;
}

.file-control {
  min-height: 48px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  border: 1px solid rgba(247, 244, 239, 0.14);
  background: rgba(255, 255, 255, 0.055);
  cursor: pointer;
}

.file-control input {
  display: none;
}

.logo-preview {
  max-width: 210px;
  max-height: 120px;
  object-fit: contain;
  border-radius: 8px;
}

.terms-box,
.error-box,
.complete-box,
.text-reward {
  padding: 16px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid rgba(247, 244, 239, 0.08);
}

.terms-box p,
.privacy-text {
  margin: 0 0 12px;
  font-size: 13px;
}

.check-row {
  flex-direction: row;
  align-items: center;
}

.check-row input {
  width: auto;
  min-height: auto;
}

.metrics-row {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 0 0 18px;
}

.metric-card {
  padding: 18px;
}

.metric-card span,
.detail-list dt {
  display: block;
  color: rgba(247, 244, 239, 0.56);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.metric-card strong {
  display: block;
  margin-top: 8px;
  font-size: 30px;
}

.detail-list {
  display: grid;
  gap: 14px;
  margin: 0 0 18px;
}

.detail-list div {
  display: grid;
  gap: 4px;
}

.detail-list dd {
  margin: 0;
  color: #f7f4ef;
}

.qr-panel {
  text-align: center;
}

.qr-canvas {
  width: 220px;
  height: 220px;
  padding: 10px;
  border-radius: 8px;
  background: #ffffff;
}

.link-field {
  margin: 16px 0 12px;
  text-align: center;
}

.button-row {
  display: flex;
  gap: 10px;
}

.actions-panel {
  min-height: 100%;
}

.status-line {
  color: #6ee7b7;
  margin: 16px 0 0;
}

.join-page {
  min-height: 100vh;
  padding: 22px 16px 48px;
}

.join-header {
  width: min(760px, 100%);
  margin: 0 auto;
}

.join-card {
  width: min(520px, 100%);
  margin: 40px auto 0;
  padding: 30px;
  border: 1px solid rgba(247, 244, 239, 0.1);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  text-align: center;
}

.join-card h1 {
  font-size: clamp(34px, 10vw, 54px);
}

.episode-line {
  margin: 18px auto 0;
}

.reward-stage {
  margin: 24px 0;
}

.join-media,
.join-audio {
  width: 100%;
  border-radius: 8px;
}

.text-reward {
  font-size: 20px;
  line-height: 1.45;
}

.center {
  text-align: center;
}

@media (max-width: 860px) {
  .page-shell {
    width: min(100% - 24px, 680px);
    padding-top: 14px;
  }

  .brand-header {
    align-items: flex-start;
    min-height: 98px;
  }

  .brand-lockup {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .brand-logo {
    width: 116px;
  }

  .form-grid,
  .dashboard-grid,
  .section-grid,
  .metrics-row,
  .input-grid,
  .input-grid.compact {
    grid-template-columns: 1fr;
  }

  .landing-page {
    width: min(100% - 20px, 680px);
    padding-top: 12px;
  }

  .landing-logo {
    width: min(180px, 62vw);
  }

  .landing-powered {
    font-size: 8px;
    letter-spacing: 0.2em;
  }

  .landing-hero {
    padding: 24px 0 16px;
  }

  .landing-hero .hero-copy h1 {
    font-size: clamp(28px, 8vw, 34px);
    line-height: 1.08;
  }

  .hero-intro {
    font-size: 12px;
    margin-bottom: 18px;
  }

  .checkout-page {
    width: min(100% - 20px, 680px);
  }

  .checkout-intro {
    padding: 22px 0 16px;
  }

  .checkout-intro h1 {
    font-size: clamp(28px, 8vw, 34px);
  }

  .checkout-grid {
    grid-template-columns: 1fr;
  }

  .button-row {
    flex-direction: column;
  }
}

