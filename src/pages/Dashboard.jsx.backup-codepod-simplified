import React, { useEffect, useMemo, useRef, useState } from 'react';
import { Link, useLocation, useNavigate } from 'react-router-dom';
import QRCode from 'qrcode';
import LanguageSwitcher from '../components/LanguageSwitcher';
import { t } from '../i18n';

const API_BASE = 'https://codenxt-backend-production.up.railway.app';

const defaultEpisode = {
  podcastName: '',
  hostName: '',
  episodeTitle: '',
  platform: '',
  releaseDate: '',
  eventDate: '',
  eventCode: '',
  code: '',
  artistLogo: '',
  customerName: '',
  email: '',
  phone: '',
  audienceSize: '',
  estimatedListeners: '',
  comment: '',
};

function readSavedEpisode() {
  try {
    return JSON.parse(localStorage.getItem('codenxt_event') || localStorage.getItem('codepod_latest_event') || '{}');
  } catch {
    return {};
  }
}

function normalizeEpisode(data = {}) {
  return {
    ...defaultEpisode,
    ...data,
    podcastName: data.podcastName || data.artistName || data.name || '',
    episodeTitle: data.episodeTitle || data.title || '',
    platform: data.platform || data.venue || '',
    releaseDate: data.releaseDate || data.eventDate || data.startAt || '',
    eventCode: data.eventCode || data.code || '',
    code: data.code || data.eventCode || '',
    estimatedListeners: data.estimatedListeners || data.audienceSize || '',
    audienceSize: data.audienceSize || data.estimatedListeners || '',
    comment: data.comment || data.comments || '',
  };
}

function makeCsv(data, eventCode) {
  const joins = Array.isArray(data?.joins) ? data.joins : [];
  const rows = [
    ['eventCode', 'rawScans', 'uniqueScans', 'innerCircleJoinCount', 'phone', 'createdAt', 'source'],
    [
      eventCode,
      data?.rawScans || 0,
      data?.uniqueScans || 0,
      data?.innerCircleJoinCount || data?.joins?.length || 0,
      '',
      '',
      'summary',
    ],
    ...joins.map((entry) => [
      eventCode,
      '',
      '',
      '',
      entry.phone || entry.mobile || '',
      entry.createdAt || entry.timestamp || '',
      entry.source || 'codepod',
    ]),
  ];

  return rows
    .map((row) =>
      row
        .map((value) => {
          const stringValue = String(value ?? '');
          return `"${stringValue.replace(/"/g, '""')}"`;
        })
        .join(',')
    )
    .join('\n');
}

export default function Dashboard({ lang, setLang }) {
  const location = useLocation();
  const navigate = useNavigate();
  const text = t(lang);
  const d = text.dashboard;
  const qrRef = useRef(null);
  const [episode, setEpisode] = useState(() => normalizeEpisode(location.state || readSavedEpisode()));
  const [stats, setStats] = useState({ rawScans: 0, uniqueScans: 0, joins: 0 });
  const [selectedRewardType, setSelectedRewardType] = useState('url');
  const [rewardTier, setRewardTier] = useState('general');
  const [accessMode, setAccessMode] = useState('evergreen');
  const [rewardInput, setRewardInput] = useState('');
  const [selectedFile, setSelectedFile] = useState(null);
  const [status, setStatus] = useState('');
  const [copied, setCopied] = useState(false);
  const [smsSending, setSmsSending] = useState(false);
  const [videoReady, setVideoReady] = useState(false);

  const eventCode = episode.eventCode || episode.code;
  const listenerLink = eventCode ? `${window.location.origin}/join/${eventCode}` : '';

  useEffect(() => {
    document.title = 'Episode Dashboard - codePod';
  }, []);

  useEffect(() => {
    const params = new URLSearchParams(location.search);
    const queryCode = params.get('event');
    if (!queryCode || episode.eventCode) return;
    setEpisode((prev) => normalizeEpisode({ ...prev, eventCode: queryCode, code: queryCode }));
  }, [location.search, episode.eventCode]);

  const loadEpisode = async () => {
    if (!eventCode) return;

    try {
      const res = await fetch(`${API_BASE}/event/${eventCode}`);
      const data = await res.json();
      if (!res.ok) return;

      setEpisode((prev) => {
        const merged = normalizeEpisode({ ...prev, ...data, eventCode: data.code || prev.eventCode });
        localStorage.setItem('codenxt_event', JSON.stringify(merged));
        return merged;
      });

      setStats({
        rawScans: Number(data?.rawScans || 0),
        uniqueScans: Number(data?.uniqueScans || 0),
        joins: Number(data?.innerCircleJoinCount || 0),
      });
    } catch (error) {
      console.error('Could not refresh codePod episode:', error);
    }
  };

  useEffect(() => {
    loadEpisode();
  }, [eventCode]);

  useEffect(() => {
    if (!qrRef.current || !listenerLink) return;
    QRCode.toCanvas(qrRef.current, listenerLink, {
      width: 220,
      margin: 1,
      color: { dark: '#050505', light: '#ffffff' },
      errorCorrectionLevel: 'H',
    });
  }, [listenerLink]);

  const metricCards = useMemo(() => {
    const listeners = Number(episode.estimatedListeners || episode.audienceSize || 0);
    const scanRate = listeners > 0 ? `${((Number(stats.uniqueScans || 0) / listeners) * 100).toFixed(1)}%` : '—';
    return [
      { label: d.listeners, value: listeners ? listeners.toLocaleString() : '—' },
      { label: d.accesses, value: Number(stats.uniqueScans || 0).toLocaleString() },
      { label: d.joins, value: Number(stats.joins || 0).toLocaleString() },
      { label: d.scanRate, value: scanRate },
    ];
  }, [episode, stats, d]);

  const copyListenerLink = async () => {
    if (!listenerLink) return;
    await navigator.clipboard.writeText(listenerLink);
    setCopied(true);
    setTimeout(() => setCopied(false), 1800);
  };

  const handleUploadReward = async () => {
    if (!eventCode || !selectedRewardType) return;
    setStatus('');

    try {
      const eventRes = await fetch(`${API_BASE}/event/${eventCode}`);
      const eventInfo = await eventRes.json();
      const backendEventId = eventInfo?.id || episode.id;
      if (!eventRes.ok || !backendEventId) throw new Error('Missing backend episode id');

      let rewardUrl = '';
      let content = '';
      if (selectedRewardType === 'url') {
        rewardUrl = rewardInput.trim();
      } else if (selectedRewardType === 'text') {
        content = rewardInput.trim();
      } else {
        if (!selectedFile) return;
        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('eventCode', eventCode);
        formData.append('vertical', 'codepod');

        const uploadRes = await fetch(`${API_BASE}/upload-reward-file`, {
          method: 'POST',
          body: formData,
        });
        const uploadData = await uploadRes.json();
        if (!uploadRes.ok || !uploadData?.url) throw new Error('File upload failed');
        rewardUrl = uploadData.url;
      }

      const reward = {
        vertical: 'codepod',
        tier: rewardTier,
        type: selectedRewardType,
        title: episode.episodeTitle || episode.podcastName || 'codePod bonus',
        description: 'codePod bonus content tied to a podcast episode.',
        url: rewardUrl,
        content,
        accessMode,
        downloadAllowed: selectedRewardType !== 'url',
      };

      const rewardRes = await fetch(`${API_BASE}/reward`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventId: backendEventId, reward }),
      });
      const rewardData = await rewardRes.json().catch(() => ({}));
      if (!rewardRes.ok || rewardData?.success === false) throw new Error('Reward save failed');

      localStorage.setItem(`codepod_reward_${eventCode}_${rewardTier}`, JSON.stringify(reward));
      setStatus(d.bonusSaved);
    } catch (error) {
      console.error('Could not save codePod bonus:', error);
      setStatus(d.reportError);
    }
  };

  const handleReport = async () => {
    if (!eventCode) return;
    try {
      const res = await fetch(`${API_BASE}/report/${eventCode}`);
      const data = await res.json();
      if (!res.ok) throw new Error('Report failed');
      localStorage.setItem(`codenxt_report_${eventCode}`, JSON.stringify(data));
      setStatus(d.reportReady);
    } catch (error) {
      console.error('Report failed:', error);
      setStatus(d.reportError);
    }
  };

  const handleDownloadCsv = async () => {
    if (!eventCode) return;
    try {
      const res = await fetch(`${API_BASE}/report/${eventCode}`);
      const data = res.ok ? await res.json() : JSON.parse(localStorage.getItem(`codenxt_report_${eventCode}`) || '{}');
      const csv = makeCsv(data, eventCode);
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `${eventCode}-codepod-report.csv`;
      anchor.click();
      URL.revokeObjectURL(url);
    } catch (error) {
      console.error('CSV failed:', error);
      setStatus(d.csvError);
    }
  };

  const handleSendFollowUp = async () => {
    if (!eventCode) return;
    setSmsSending(true);
    try {
      const res = await fetch(`${API_BASE}/send-innercircle-sms`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventCode, vertical: 'codepod' }),
      });
      if (!res.ok) throw new Error('Follow-up failed');
      setStatus(d.followUpReady);
    } catch (error) {
      console.error('Follow-up failed:', error);
      setStatus(d.reportError);
    } finally {
      setSmsSending(false);
    }
  };

  if (!eventCode) {
    return (
      <main className="page-shell dashboard-page">
        <header className="landing-header">
          <Link to="/" aria-label="codePod">
            <img src="/codepod-logo.png" alt="codePod logo" className="landing-logo" />
          </Link>
          <div className="landing-powered">{text.common.powered}</div>
          <LanguageSwitcher lang={lang} onChange={setLang} />
        </header>
        <section className="panel empty-panel">
          <h1>{d.noEpisode}</h1>
          <button type="button" className="primary-cta" onClick={() => navigate('/checkout')}>
            {text.nav.checkout}
          </button>
        </section>
      </main>
    );
  }

  return (
    <main className="page-shell dashboard-page">
      <header className="landing-header">
        <Link to="/" aria-label="codePod">
          <img src="/codepod-logo.png" alt="codePod logo" className="landing-logo" />
        </Link>
        <div className="landing-powered">{text.common.powered}</div>
        <LanguageSwitcher lang={lang} onChange={setLang} />
      </header>

      <section className="page-intro dashboard-intro">
        <h1>{d.title}</h1>
        <p>{d.subtitle}</p>
      </section>

      <section className="metrics-row">
        {metricCards.map((metric) => (
          <article className="metric-card" key={metric.label}>
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
          </article>
        ))}
      </section>

      <section className="dashboard-grid">
        <article className="panel">
          <h2>{d.details}</h2>
          <dl className="detail-list">
            <div><dt>{d.podcast}</dt><dd>{episode.podcastName || text.common.unavailable}</dd></div>
            <div><dt>{d.episode}</dt><dd>{episode.episodeTitle || text.common.unavailable}</dd></div>
            <div><dt>{d.platform}</dt><dd>{episode.platform || text.common.unavailable}</dd></div>
            <div><dt>{d.releaseDate}</dt><dd>{episode.releaseDate ? new Date(episode.releaseDate).toLocaleDateString() : text.common.unavailable}</dd></div>
            <div><dt>{d.customer}</dt><dd>{episode.customerName || episode.email || text.common.unavailable}</dd></div>
            <div><dt>{d.comments}</dt><dd>{episode.comment || text.common.unavailable}</dd></div>
          </dl>
          <button type="button" className="secondary-button" onClick={loadEpisode}>
            {d.refresh}
          </button>
        </article>

        <article className="panel qr-panel">
          <h2>{d.linkAccess}</h2>
          <canvas ref={qrRef} className="qr-canvas" />
          <input readOnly value={listenerLink} className="link-field" />
          <div className="button-row">
            <button type="button" className="secondary-button" onClick={copyListenerLink}>
              {copied ? text.common.copied : d.copyListenerLink}
            </button>
            <a className="secondary-button" href={listenerLink} target="_blank" rel="noreferrer">
              {d.openJoin}
            </a>
          </div>
        </article>

        <article className="panel bonus-panel">
          <h2>{d.bonus}</h2>
          <div className="input-grid compact">
            <label>
              {d.bonusTier}
              <select value={rewardTier} onChange={(event) => setRewardTier(event.target.value)}>
                <option value="general">{d.general}</option>
                <option value="silver">{d.silver}</option>
                <option value="gold">{d.gold}</option>
              </select>
            </label>
            <label>
              {d.bonusAccess}
              <select value={accessMode} onChange={(event) => setAccessMode(event.target.value)}>
                <option value="evergreen">{d.evergreen}</option>
                <option value="moment">{d.moment}</option>
              </select>
            </label>
            <label>
              {d.bonusType}
              <select value={selectedRewardType} onChange={(event) => setSelectedRewardType(event.target.value)}>
                <option value="url">{d.url}</option>
                <option value="text">{d.text}</option>
                <option value="audio">{d.audio}</option>
                <option value="video">{d.video}</option>
                <option value="image">{d.image}</option>
                <option value="pdf">{d.pdf}</option>
              </select>
            </label>

            {(selectedRewardType === 'url' || selectedRewardType === 'text') ? (
              <label>
                {selectedRewardType === 'url' ? d.bonusUrl : d.text}
                <textarea value={rewardInput} onChange={(event) => setRewardInput(event.target.value)} />
              </label>
            ) : (
              <label>
                {d.uploadBonus}
                <span className="file-control">
                  {d.file}
                  <input type="file" onChange={(event) => setSelectedFile(event.target.files?.[0] || null)} />
                </span>
                {selectedFile && <span className="muted">{selectedFile.name}</span>}
              </label>
            )}
          </div>
          <button type="button" className="primary-cta full-width" onClick={handleUploadReward}>
            {d.saveBonus}
          </button>
        </article>

        <article className="panel podcast-video-panel">
          <div>
            <h2>{d.videoTitle}</h2>
            <p className="panel-copy">{d.videoExplanation}</p>
          </div>

          <div className="video-preview-card" aria-label={d.videoTitle}>
            <div className="video-window">
              <div className="video-window-bar" />
              <img src="/codepod-logo.png" alt="" className="video-preview-logo" />
              <p>{d.videoPreviewText}</p>
              <div className="qr-placeholder">
                <span />
                <span />
                <span />
                <span />
              </div>
            </div>
          </div>

          <p className="future-note">{d.videoNote}</p>
          <button type="button" className="primary-cta full-width" onClick={() => setVideoReady(true)}>
            {d.createPodcastVideo}
          </button>
          {videoReady && <p className="status-line">{d.videoReady}</p>}
        </article>

        <article className="panel actions-panel">
          <h2>{d.report}</h2>
          <div className="button-column">
            <button type="button" className="secondary-button" onClick={handleReport}>{d.makeReport}</button>
            <button type="button" className="secondary-button" onClick={handleDownloadCsv}>{d.downloadCsv}</button>
            <button type="button" className="secondary-button" onClick={handleSendFollowUp} disabled={smsSending}>
              {smsSending ? d.followUpSending : d.sendFollowUp}
            </button>
          </div>
          {status && <p className="status-line">{status}</p>}
        </article>
      </section>
    </main>
  );
}
